{
  "info": {
    "name": "Healthcare Scheduling System",
    "description": "Complete GraphQL API collection for Healthcare Scheduling System\n\nServices:\n- Auth Service (Port 3001): User registration, login, token validation\n- Schedule Service (Port 3002): Customer, Doctor, Schedule management\n\nSetup:\n1. Run docker compose up -d\n2. Execute 'Register User' request\n3. Copy accessToken from response\n4. Set {{jwt_token}} variable in Postman environment\n5. All Schedule Service requests will use this token automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:3001/graphql",
      "type": "string"
    },
    {
      "key": "schedule_url",
      "value": "http://localhost:3002/graphql",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.register) {",
                  "        pm.environment.set('jwt_token', response.data.register.accessToken);",
                  "        pm.environment.set('user_id', response.data.register.user.id);",
                  "        console.log('✅ JWT Token saved to environment');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RegisterUser($email: String!, $password: String!) {\n  register(data: { email: $email, password: $password }) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.login) {",
                  "        pm.environment.set('jwt_token', response.data.login.accessToken);",
                  "        console.log('✅ JWT Token updated');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginUser($email: String!, $password: String!) {\n  login(data: { email: $email, password: $password }) {\n    accessToken\n    user {\n      id\n      email\n      createdAt\n      updatedAt\n    }\n  }\n}",
                "variables": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken {\n  validateToken {\n    id\n    email\n    createdAt\n    updatedAt\n  }\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          }
        }
      ]
    },
