# Docker Environment Variables
# Copy this file to .env.docker and update values for production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db

# JWT Configuration (MUST CHANGE IN PRODUCTION!)
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=30m

# Database URLs
AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db
SCHEDULE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/schedule_db

# Service Ports
AUTH_SERVICE_PORT=3001
SCHEDULE_SERVICE_PORT=3002
POSTGRES_PORT=5433
